[Desktop Entry]
Version=1.0
Type=Application
Name=Chromium
Comment=Browse the web and sign in inside this container
Exec=/usr/local/bin/launch-browser %U
Icon=chromium
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=chromium
StartupNotify=true
